# ============================================================
# TG DGN Bot - Zeabur 部署环境变量模板
# ============================================================
# 使用方法：
# 1. 在 Zeabur 项目设置中添加以下环境变量
# 2. 带 [必填] 标记的变量必须设置
# 3. 带 [生产] 标记的变量在生产环境必须修改
# 4. 带 [可选] 标记的变量使用默认值即可
# ============================================================

# ------------------------------------------------------------
# 🤖 Telegram Bot 基础配置
# ------------------------------------------------------------

# [必填][生产] Bot Token - 从 @BotFather 获取
BOT_TOKEN=your_telegram_bot_token_here

# [必填][生产] Bot Owner ID - 管理员 Telegram 用户 ID
# 获取方式：将任意消息转发给 @userinfobot
BOT_OWNER_ID=123456789

# [可选] Webhook 模式（Zeabur 推荐使用 webhook）
USE_WEBHOOK=true

# [可选] 服务监听配置（Zeabur 自动管理端口）
BOT_SERVICE_HOST=0.0.0.0
BOT_SERVICE_PORT=8080

# [生产] Webhook URL - Zeabur 分配的域名
# 格式：https://your-app.zeabur.app/webhook
BOT_WEBHOOK_URL=https://your-app.zeabur.app/webhook

# [可选] 实例名称
BOT_INSTANCE_NAME=primary

# ------------------------------------------------------------
# 💰 支付配置
# ------------------------------------------------------------

# [必填][生产] USDT TRC20 收款地址
USDT_TRC20_RECEIVE_ADDR=TYourUSDTReceiveAddress

# [必填][生产] Webhook 签名密钥（随机字符串，用于验证请求）
WEBHOOK_SECRET=your_random_secret_key_here

# ------------------------------------------------------------
# 🗄️ 数据库配置
# ------------------------------------------------------------

# [必填] 数据库连接字符串
# 本地测试：sqlite:///./tg_bot.db
# 生产环境：建议使用 PostgreSQL 或 Zeabur 提供的数据库服务
DATABASE_URL=sqlite:///./tg_bot.db

# ------------------------------------------------------------
# 📦 Redis 配置
# ------------------------------------------------------------

# [可选] Redis 连接配置
# Zeabur 提供 Redis 服务，从服务详情获取连接信息
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ------------------------------------------------------------
# ⏰ 订单设置
# ------------------------------------------------------------

# [可选] 订单超时时间（分钟）
ORDER_TIMEOUT_MINUTES=30

# [可选] 价格小数位数
BASE_PRICE_DECIMAL_PLACES=3

# ------------------------------------------------------------
# 🔗 TRON 区块链配置
# ------------------------------------------------------------

# [可选] TRON API 配置（用于查询交易）
TRON_API_URL=https://api.trongrid.io
TRON_API_KEY=your_trongrid_api_key

# [可选] 区块浏览器选择：tronscan | oklink
TRON_EXPLORER=tronscan

# [可选] 地址查询限频（分钟）
ADDRESS_QUERY_RATE_LIMIT_MINUTES=1

# ------------------------------------------------------------
# ⚡ 能量服务配置
# ------------------------------------------------------------

# [生产] 能量 API 账号（trxno.com）
ENERGY_API_USERNAME=your_trxno_username
ENERGY_API_PASSWORD=your_trxno_password
ENERGY_API_BASE_URL=https://trxno.com
ENERGY_API_BACKUP_URL=https://trxfast.com

# [生产] 能量代理地址
ENERGY_RENT_ADDRESS=TYourEnergyRentAddress
ENERGY_PACKAGE_ADDRESS=TYourPackageAddress
ENERGY_FLASH_ADDRESS=TYourFlashExchangeAddr

# ------------------------------------------------------------
# 🔄 TRX 兑换配置
# ------------------------------------------------------------

# [生产] TRX 兑换地址
TRX_EXCHANGE_RECEIVE_ADDRESS=TYourTRXExchangeReceiveAddress
TRX_EXCHANGE_SEND_ADDRESS=TYourTRXSendAddress

# [生产][敏感] TRX 发送钱包私钥
# ⚠️ 警告：绝对不要泄露此值！
TRX_EXCHANGE_PRIVATE_KEY=your_trx_wallet_private_key_here

# [可选] 收款二维码 Telegram file_id
TRX_EXCHANGE_QRCODE_FILE_ID=

# [可选] 默认汇率（1 USDT = X TRX）
TRX_EXCHANGE_DEFAULT_RATE=3.05

# [生产] 测试模式开关
# true: 不实际转账（测试用）
# false: 生产模式（实际转账）
TRX_EXCHANGE_TEST_MODE=false

# ------------------------------------------------------------
# 📊 API 服务配置
# ------------------------------------------------------------

# [可选] API 服务端口（Zeabur 可能需要调整）
API_HOST=0.0.0.0
API_PORT=8001

# [生产] API 密钥（逗号分隔多个）
API_KEYS=your_api_key_1,your_api_key_2

# [可选] 日志级别：DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# [可选] JSON 格式日志（生产推荐 true）
LOG_JSON_FORMAT=true

# [可选] 运行环境：dev | staging | prod
ENV=prod

# ------------------------------------------------------------
# 🌐 时区配置
# ------------------------------------------------------------

# [推荐] 时区设置（影响订单时间显示）
TZ=Asia/Shanghai

# ------------------------------------------------------------
# 📝 自定义文案（可选）
# ------------------------------------------------------------

# 欢迎语（支持 HTML 格式，{first_name} 替换为用户名）
# WELCOME_MESSAGE=👋 欢迎 {first_name}！

# 免费克隆服务文案（支持 HTML 格式）
# FREE_CLONE_MESSAGE=🎁 <b>免费克隆服务</b>

# 客服联系方式
SUPPORT_CONTACT=@your_support_bot

# 引流按钮配置（JSON 格式）
# PROMOTION_BUTTONS=[{"text": "💎 开会员", "callback": "menu_premium"}]

# ============================================================
# 📋 Zeabur 部署检查清单
# ============================================================
# □ BOT_TOKEN 已设置为真实 Token
# □ BOT_OWNER_ID 已设置为管理员 ID
# □ USDT_TRC20_RECEIVE_ADDR 已设置为真实地址
# □ WEBHOOK_SECRET 已设置为随机密钥
# □ BOT_WEBHOOK_URL 已设置为 Zeabur 分配的域名
# □ TRX_EXCHANGE_TEST_MODE 已设置为 false（生产）
# □ TRX_EXCHANGE_PRIVATE_KEY 已安全设置（如需 TRX 兑换）
# ============================================================
