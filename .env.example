# Telegram Bot
BOT_TOKEN=your_telegram_bot_token
USE_WEBHOOK=false
BOT_SERVICE_HOST=0.0.0.0
BOT_SERVICE_PORT=8080
BOT_WEBHOOK_URL=https://your-domain.com/bot-path
BOT_INSTANCE_NAME=primary
BOT_PRIMARY_PORT=8080
BOT_SECONDARY_PORT=8081
BOT_PRIMARY_WEBHOOK_URL=https://your-domain.com/bot-primary
BOT_SECONDARY_WEBHOOK_URL=https://your-domain.com/bot-secondary

# Bot Owner (Admin Panel Access)
BOT_OWNER_ID=123456789  # 替换为你的 Telegram 用户 ID（如何获取：将消息转发给 @userinfobot）

# USDT TRC20 Payment
USDT_TRC20_RECEIVE_ADDR=TYourUSDTReceiveAddress

# HMAC Signature
WEBHOOK_SECRET=your_webhook_secret_key

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Database
DATABASE_URL=sqlite:///./data/tg_db.sqlite

# Order Settings
ORDER_TIMEOUT_MINUTES=30
BASE_PRICE_DECIMAL_PLACES=3
# TRON API (Optional)
TRON_API_URL=
TRON_API_KEY=
TRON_EXPLORER=tronscan

# Address Query Rate Limit
ADDRESS_QUERY_RATE_LIMIT_MINUTES=1

# Energy API Configuration
ENERGY_API_USERNAME=your_trxno_username
ENERGY_API_PASSWORD=your_trxno_password
ENERGY_API_BASE_URL=https://trxno.com
ENERGY_API_BACKUP_URL=https://trxfast.com

# Energy Proxy Addresses (TRX Direct Transfer)
ENERGY_RENT_ADDRESS=TYourEnergyRentAddress  # 时长能量收TRX地址
ENERGY_PACKAGE_ADDRESS=TYourPackageAddress  # 笔数套餐收USDT地址
ENERGY_FLASH_ADDRESS=TYourFlashExchangeAddr  # 闪兑收USDT地址

# TRX Exchange Configuration
TRX_EXCHANGE_RECEIVE_ADDRESS=TYourTRXExchangeReceiveAddress  # 收USDT地址
TRX_EXCHANGE_SEND_ADDRESS=TYourTRXSendAddress  # 发TRX地址
TRX_EXCHANGE_PRIVATE_KEY=your_trx_wallet_private_key_here  # 发TRX私钥（生产环境填写，请妥善保管！）
TRX_EXCHANGE_QRCODE_FILE_ID=YOUR_QRCODE_FILE_ID_HERE  # 收款二维码 Telegram file_id（见下方说明）
TRX_EXCHANGE_DEFAULT_RATE=3.05  # 默认汇率（1 USDT = X TRX，管理员可通过命令修改）
TRX_EXCHANGE_TEST_MODE=true  # 测试模式（true: 不实际转账，false: 生产模式）

# 如何获取 TRX_EXCHANGE_QRCODE_FILE_ID:
# 1. 生成收款地址二维码图片
# 2. 将图片发送到 Bot 或频道
# 3. 使用 getUpdates API 或转发消息获取 file_id
# 4. 填入上方配置

# Free Clone Feature Message
# 免费克隆功能展示文案（支持HTML格式）
# 默认值已在 config.py 中设置，如需自定义可在此覆盖
# FREE_CLONE_MESSAGE="🎁 <b>免费克隆服务</b>\n\n您的自定义文案..."

# Welcome Message Configuration
# 欢迎语配置（支持HTML格式，{first_name} 会被替换为用户名）
# WELCOME_MESSAGE="👋 欢迎 {first_name}！\n\n您的自定义欢迎语..."

# Promotion Buttons Configuration
# 引流按钮配置（JSON格式，每行最多2个按钮）
# 格式：[{"text": "按钮文字", "url": "外部链接"}, {"text": "按钮2", "callback": "回调数据"}]
# 示例：
# PROMOTION_BUTTONS='[{"text": "💎 开会员", "callback": "menu_premium"}, {"text": "💰 价格", "url": "https://example.com"}],[{"text": "📱 频道", "url": "https://t.me/yourchannel"}]'
